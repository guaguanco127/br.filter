                                    "patching_rect": [
                                        15.0,
                                        339.0,
                                        290.0,
                                        47.0
                                    ],
                                    "text": "Gain only changes peak and the shelves. Autogain holds the peak level as Q rises (lowpass, highpass, resonbp, shelves)."
                                }
                            },
